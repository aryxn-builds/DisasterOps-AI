# ==============================================================
# DisasterOps AI: Environment Configuration
# ==============================================================

# 1. Supabase Cloud Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 2. PostgreSQL Direct Connection String (Optional if using Supabase client)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# 3. Rescue Department Admin Credentials
RESCUE_ADMIN_USER=rescue123
RESCUE_ADMIN_PASSWORD=RSC123

# 4. Find My Device External API (For detecting unregistered victims - Grey Dots)
FIND_MY_DEVICE_API_KEY=your-google-find-my-device-api-key-here
FIND_MY_DEVICE_ENDPOINT=https://api.findmydevice.services/v1/telemetry

# 5. Fast API Cloud Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Must be HTTPS for phones (browser GPS) and for capcom6 webhooks.
# e.g. run: cloudflared tunnel --url http://localhost:8000   and paste the https URL here
SERVER_PUBLIC_URL=https://your-tunnel.trycloudflare.com
DISPATCH_TIMER_INTERVAL_SECONDS=300 # 5 minutes scheduled sync with rescue teams
# SIM number of the Android phone running capcom6. Citizens' offline location SMS are sent HERE
# (NOT 112 -- messages to 112 never reach this server).
EMERGENCY_SMS_GATEWAY_NUMBER=+919XXXXXXXXX
# Unsigned test endpoint /api/v1/sms/inbound (used by the in-app simulator). Set false in production.
ALLOW_SMS_SIMULATOR=true

# 6. Android SMS Gateway (capcom6/android-sms-gateway) Configuration
# Turns an Android device with SIM into an automated emergency SMS station
# APK: https://github.com/capcom6/android-sms-gateway/releases
ANDROID_SMS_GATEWAY_ENABLED=true
ANDROID_SMS_GATEWAY_URL=http://192.168.1.100:8080 # IP shown in the Android app
ANDROID_SMS_GATEWAY_USER=admin
ANDROID_SMS_GATEWAY_PASSWORD=admin
# capcom6 app -> Settings -> Webhooks -> Signing Key. Leave EMPTY to skip signature checks.
ANDROID_SMS_GATEWAY_WEBHOOK_SECRET=


