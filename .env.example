# PostgreSQL is required. Set the connection string for a fresh project database.
DATABASE_URL=postgresql://disasterops:replace-with-your-password@127.0.0.1:5432/disasterops

# Local development only. For HTTPS, set the exact public origin and SECURE_COOKIES=true.
SERVER_PUBLIC_URL=http://127.0.0.1:8000
SECURE_COOKIES=false

# Optional dedicated project SIM. The browser retrieves and caches this public number.
# EMERGENCY_SMS_GATEWAY_NUMBER=+12025550101
# Optional Android gateway signing key. An unset key disables inbound SMS.
# ANDROID_SMS_GATEWAY_WEBHOOK_SECRET=
# Optional outbound location-request SMS. All three settings are required.
# ANDROID_SMS_GATEWAY_URL=
# ANDROID_SMS_GATEWAY_USER=
# ANDROID_SMS_GATEWAY_PASSWORD=
